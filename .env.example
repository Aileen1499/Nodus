# ==============================================================================
# NODUS ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Salin file ini menjadi `.env` atau `.env.local` dan isi dengan kredensial Anda.
# Nilai-nilai ini juga dapat dipasang langsung di Vercel Settings > Environment Variables.

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Dapatkan Gemini API Key gratis di Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. FIREBASE AUTH & CLOUD FIRESTORE CONFIGURATION
# ------------------------------------------------------------------------------
# Dapatkan dari Firebase Console: https://console.firebase.google.com/
# Project Settings > General > Your apps > Web app (SDK setup and configuration)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
VITE_FIREBASE_AUTH_DOMAIN=nodus-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nodus-app
VITE_FIREBASE_STORAGE_BUCKET=nodus-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# (Opsional) Kompatibilitas jika di-deploy dengan Next.js / framework lain
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nodus-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nodus-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nodus-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 3. WHATSAPP & PAYWALL PRO UPGRADE CONFIGURATION
# ------------------------------------------------------------------------------
VITE_WHATSAPP_SUPPORT_NUMBER=6281234567890

