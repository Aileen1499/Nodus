rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil pengguna: hanya pemilik. isPro hanya boleh diubah server (Admin SDK melewati aturan ini).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.isPro == false;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.isPro == resource.data.isPro;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /user_progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Daftar tunggu: siapa pun boleh menulis dokumen miliknya sendiri, tidak boleh membaca.
    // Pemilik produk membaca lewat Firebase Console.
    match /waitlist/{id} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['plans', 'email', 'uid', 'updatedAt'])
                            && request.resource.data.plans is list && request.resource.data.plans.size() <= 8
                            && (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
                            && (request.auth == null ? request.resource.data.uid == null : (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid))
                            && (request.auth == null || id == request.auth.uid || id.matches('d[0-9a-f]{12,24}'))
                            && id.size() <= 40;
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
